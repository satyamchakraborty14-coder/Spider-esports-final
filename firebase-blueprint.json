        "userId": { "type": "string" },
        "tournamentId": { "type": "string" },
        "matchId": { "type": "string" },
        "reason": { "type": "string" },
        "status": { "type": "string", "enum": ["OPEN", "REVIEWING", "RESOLVED", "DISMISSED"] },
